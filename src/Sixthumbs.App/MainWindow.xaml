<Window x:Class="Sixthumbs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Sixthumbs.App"
        Title="Sixthumbs"
        Height="820" Width="1100"
        MinHeight="640" MinWidth="900">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <RadioButton Content="Host" IsChecked="{Binding IsHost}" GroupName="Role" Margin="0,0,10,0" IsEnabled="{Binding Running, Converter={StaticResource Not}}"/>
                        <RadioButton Content="Client" IsChecked="{Binding IsClient}" GroupName="Role" IsEnabled="{Binding Running, Converter={StaticResource Not}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding IsHost, Converter={StaticResource VisibleIfTrue}}">
                        <TextBlock Text="Listen port" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ListenPort}" Width="70" Margin="0,0,10,0"/>
                        <CheckBox Content="Accept TCP clients" IsChecked="{Binding ListenEnabled}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding IsClient, Converter={StaticResource VisibleIfTrue}}">
                        <TextBlock Text="Host" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding HostAddress}" Width="160" Margin="0,0,8,0"/>
                        <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ListenPort}" Width="70"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <TextBlock Text="Password" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Password}" Width="140"/>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ToggleCommand}" Width="110" Height="32" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Start"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Running}" Value="True">
                                        <Setter Property="Content" Value="Stop"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PeerCount, StringFormat=TCP clients: {0}}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10" Margin="0,10,0,0" Height="220">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Merged virtual pad" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding OutputStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <app:GamepadPreview State="{Binding MergedState}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8"
                    MinWidth="280" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Devices" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap">
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Id, Mode=OneWay}"/>
                                    </TextBlock>
                                    <CheckBox Content="Mute" IsChecked="{Binding Muted, Mode=TwoWay}" Margin="0,4,0,0"/>
                                    <app:GamepadPreview Height="90" State="{Binding LiveState}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Patchbay" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel>
                            <GroupBox Header="Raw joystick → X360" Margin="0,0,0,12"
                                      Visibility="{Binding ShowJoystickBindings, Converter={StaticResource VisibleIfTrue}}"
                                      Foreground="{StaticResource TextBrush}">
                                <ItemsControl ItemsSource="{Binding JoystickRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,2" Margin="0,1" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource LiveRowBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center"/>
                                                    <Slider Width="88" Minimum="0" Maximum="1" Value="{Binding Visualizer, Mode=OneWay}"
                                                            IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ComboBox Width="140" ItemsSource="{Binding DataContext.Controls, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Destination}"/>
                                                    <CheckBox Content="Invert" IsChecked="{Binding Invert}" Margin="8,0,0,0" Visibility="{Binding ShowInvert, Converter={StaticResource VisibleIfTrue}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Save Preset" Command="{Binding SavePresetCommand}" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="Load Preset" Command="{Binding LoadPresetCommand}" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="Reset to Defaults" Command="{Binding ResetDefaultsCommand}" Padding="10,4"/>
                            </StackPanel>
                            <TextBlock Text="X360 remapping" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Virtual" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="On" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="From source" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="Invert" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="Deadzone" FontWeight="SemiBold"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MappingRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,4" Margin="0,0,0,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource LiveRowBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DestinationName}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2" Margin="0,0,8,0"
                                                          ItemsSource="{Binding DataContext.Controls, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Grid.Column="3" IsChecked="{Binding Invert}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="4" Minimum="0" Maximum="0.9" SmallChange="0.05"
                                                        Value="{Binding Deadzone, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding ShowAnalogOptions}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
